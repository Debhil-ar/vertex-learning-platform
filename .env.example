# Sanity — public (safe for the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-08

# Sanity — server only. A Viewer (read-only) token from
# https://www.sanity.io/manage -> your project -> API -> Tokens.
# Never prefix this with NEXT_PUBLIC_ and never import it into a client component.
SANITY_API_READ_TOKEN=your-read-token

# Sanity — server only. An Editor (write) token, used only by offline
# scripts (studio/script/seed.ts, studio/script/seed-search-context.ts).
# Never used by the running app.
SANITY_API_WRITE_TOKEN=your-write-token

# Sanity Context — server only. The slug of the sanity.agentContext document
# (created by studio/script/seed-search-context.ts) that scopes and guides
# the search agent's MCP access.
SANITY_CONTEXT_SLUG=vertex-search

# OpenAI — server only. Used by the search agent (lib/search.ts) via the
# Vercel AI SDK.
OPENAI_API_KEY=your-openai-api-key

# Clerk — public (safe for the browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk — server only
CLERK_SECRET_KEY=sk_test_xxx

# PostHog — public (safe for the browser)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
