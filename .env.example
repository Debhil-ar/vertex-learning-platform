# Sanity — public (safe for the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-09-08

# Sanity — server only. A Viewer (read-only) token from
# https://www.sanity.io/manage -> your project -> API -> Tokens.
# Never prefix this with NEXT_PUBLIC_ and never import it into a client component.
SANITY_API_READ_TOKEN=your-read-token

# Sanity — server only. An Editor (write) token, used only by the offline
# seed script (studio/script/seed.ts). Never used by the running app.
SANITY_API_WRITE_TOKEN=your-write-token

# Clerk — public (safe for the browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk — server only
CLERK_SECRET_KEY=sk_test_xxx
